<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      毎日 22:00 (JST) に review.py を実行する launchd 設定。
      インストール:
        cp launchd/com.iorn.claude-automation-review.plist ~/Library/LaunchAgents/
        launchctl load ~/Library/LaunchAgents/com.iorn.claude-automation-review.plist
      アンインストール:
        launchctl unload ~/Library/LaunchAgents/com.iorn.claude-automation-review.plist
        rm ~/Library/LaunchAgents/com.iorn.claude-automation-review.plist
      手動実行:
        launchctl start com.iorn.claude-automation-review
      ログ確認:
        tail -f ~/Documents/workspace/claude-automation/launchd/review-stdout.log
        tail -f ~/Documents/workspace/claude-automation/launchd/review-stderr.log
    -->
    <key>Label</key>
    <string>com.iorn.claude-automation-review</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/user/Documents/workspace/claude-automation/.venv/bin/python</string>
        <string>/Users/user/Documents/workspace/claude-automation/scripts/review.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/user/Documents/workspace/claude-automation</string>

    <!-- 毎日 22:00 に起動（1日の終わり） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>22</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/user/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/user</string>
        <key>LANG</key>
        <string>ja_JP.UTF-8</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/user/Documents/workspace/claude-automation/launchd/review-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/user/Documents/workspace/claude-automation/launchd/review-stderr.log</string>
</dict>
</plist>
