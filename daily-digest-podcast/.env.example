# このファイルを .env という名前でコピーして、値を貼り付けてください。
# 例: cp .env.example .env
#
# .env 自体は .gitignore 済みなので、GitHubには上がりません。
# （GitHub Actionsで動かすときは、この.envではなくリポジトリのSecrets/Variablesを使います）

GEMINI_API_KEY=

# ローカルで動作確認するだけなら、ひとまずこのままでOK
PODCAST_BASE_URL=http://localhost

# 通常は変更不要
VOICEVOX_URL=http://127.0.0.1:50021
# 互換: ホスト話者のフォールバック（VOICEVOX_SPEAKER_HOST 未設定時）
VOICEVOX_SPEAKER=8
# 対話2話者（ホスト=春日部つむぎ / ゲスト=ずんだもん）
VOICEVOX_SPEAKER_HOST=8
VOICEVOX_SPEAKER_GUEST=3
