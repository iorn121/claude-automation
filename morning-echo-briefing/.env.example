# cp .env.example .env
# .env は git に含まれない。GitHub Actions では Secrets / Variables を使う。

# 台本を口語に整える。空なら定型文のまま読み上げる
GEMINI_API_KEY=

# 既存 Podcast の GitHub Pages。末尾スラッシュなし
# 例: https://<user>.github.io/claude-automation
PODCAST_BASE_URL=http://localhost

# 公開 URL の秘密パス。openssl rand -hex 16 で作る。16文字以上
# BRIEFING_PATH_TOKEN=

# リポジトリ直下の token.json を使うなら省略可
# GOOGLE_TOKEN_PATH=../token.json
GOOGLE_CALENDAR_ID=primary
# GOOGLE_TASKLIST_ID=@default

BRIEFING_TIMEZONE=Asia/Tokyo
# Echo に鳴らす現地時刻。ワークフローはこれの約20分前に起動する
ANNOUNCE_AT=07:00

VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=8

# プッシュ通知（Voice Monkey）。空なら送信しない
# VOICE_MONKEY_TOKEN=
# VOICE_MONKEY_DEVICE=
# 日本語の Polly 音声。音声ファイル再生のときは使わない
VOICE_MONKEY_VOICE=Mizuki
VOICE_MONKEY_LANGUAGE=ja-JP
# 空文字にすると開始音なし
# VOICE_MONKEY_CHIME=
